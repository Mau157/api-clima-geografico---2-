          "path": ["api", "v1", "cidades", "XX"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code é 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Código de erro é UF_NAO_ENCONTRADA', function () {",
              "    const corpo = pm.response.json();",
              "    pm.expect(corpo.codigo).to.eql('UF_NAO_ENCONTRADA');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cidades por Estado - sigla inválida (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/cidades/ceara",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cidades", "ceara"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code é 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Código de erro é SIGLA_UF_INVALIDA', function () {",
              "    const corpo = pm.response.json();",
              "    pm.expect(corpo.codigo).to.eql('SIGLA_UF_INVALIDA');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
